# ---------------------------------------------------------------------------
# Copy to .env and fill in.  Get a free Gemini API key at
# https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your-gemini-api-key-here

# Generation model used by the systems under test.
EVAL_GENERATION_MODEL=gemini-2.0-flash

# Judge model.  Keep it DIFFERENT from the generation model wherever possible
# so a model is never grading its own output (see Chapter 3, self-preference).
EVAL_JUDGE_MODEL=gemini-2.0-flash-lite

# Embedding model used for the vector store and for embedding-drift detection.
EVAL_EMBEDDING_MODEL=models/text-embedding-004

# Free-tier friendly concurrency + rate limiting.
EVAL_MAX_CONCURRENCY=4
EVAL_REQUESTS_PER_MINUTE=14

# Local artefact locations (relative to the project root).
EVAL_DATA_DIR=data
EVAL_ARTIFACT_DIR=artifacts
EVAL_CHROMA_DIR=artifacts/chroma
EVAL_CACHE_PATH=artifacts/llm_cache.sqlite
EVAL_STORE_PATH=artifacts/experiments.sqlite

# Deterministic decoding for evaluation runs.
EVAL_TEMPERATURE=0.0
EVAL_JUDGE_TEMPERATURE=0.0
EVAL_SEED=1337
